{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/products/:id/questions",
      "destination": "/api/report?resource=questions&id=:id"
    },
    {
      "source": "/api/questions/:id/answer",
      "destination": "/api/report?resource=answer&question_id=:id"
    },
    {
      "source": "/api/chats/:id/messages",
      "destination": "/api/support?resource=chat_messages&chat_id=:id"
    },
    {
      "source": "/api/chats",
      "destination": "/api/support?resource=chats"
    },
    {
      "source": "/api/admin/message-reports",
      "destination": "/api/report?resource=admin_reports"
    },
    {
      "source": "/api/admin/messages/:id/remove",
      "destination": "/api/report?resource=admin_remove_message&message_id=:id"
    },
    {
      "source": "/api/seller/freight-average",
      "destination": "/api/orders?resource=freight_average"
    },
    {
      "source": "/api/seller/profile",
      "destination": "/api/orders?resource=seller_profile"
    },
    {
      "source": "/api/shipping/calculate",
      "destination": "/api/orders?resource=shipping_calculate"
    },
    {
      "source": "/api/checkout",
      "destination": "/api/orders?resource=checkout"
    },
    {
      "source": "/api/payment/mock-confirm",
      "destination": "/api/orders?resource=mock_confirm"
    },
    {
      "source": "/api/admin/configuracao",
      "destination": "/api/orders?resource=admin_config"
    },
    {
      "source": "/api/admin/tickets/:id/reply",
      "destination": "/api/support?resource=admin_ticket_reply&id=:id"
    },
    {
      "source": "/api/admin/tickets/:id/status",
      "destination": "/api/support?resource=admin_ticket_status&id=:id"
    },
    {
      "source": "/api/admin/tickets/:id",
      "destination": "/api/support?resource=admin_ticket&id=:id"
    },
    {
      "source": "/api/admin/tickets",
      "destination": "/api/support?resource=admin_tickets"
    },
    {
      "source": "/api/admin/usuarios/:id/banir",
      "destination": "/api/admin/index?resource=user_ban&id=:id"
    },
    {
      "source": "/api/admin/usuarios",
      "destination": "/api/admin/index?resource=users"
    },
    {
      "source": "/api/admin/reivindicacoes/:id/aprovar",
      "destination": "/api/admin/index?resource=claim_approve&id=:id"
    },
    {
      "source": "/api/admin/reivindicacoes/:id/rejeitar",
      "destination": "/api/admin/index?resource=claim_reject&id=:id"
    },
    {
      "source": "/api/admin/reivindicacoes",
      "destination": "/api/admin/index?resource=claims"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
